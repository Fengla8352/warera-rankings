{
  // The name must match the project name shown in Cloudflare's setup screen.
  "name": "warera-rankings",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs for /api/* and for the three pages (to fill in the site address for link previews). Other files are served as static assets.
    "run_worker_first": ["/api/*", "/", "/index.html", "/country", "/country.html", "/reports", "/reports.html"]
  },
  // Storage for the income history. Wrangler creates this KV namespace on the first deploy if it does not exist.
  // If your build says it cannot do that, create a KV namespace in the dashboard and add "id": "<its id>" here.
  "kv_namespaces": [{ "binding": "HISTORY" }],
  // Runs every hour: takes an income snapshot about every 2 hours and sends the daily Discord reports that are due.
  "triggers": { "crons": ["0 * * * *"] }
}
